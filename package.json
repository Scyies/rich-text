{
  "name": "wealthy-text-editor",
  "version": "0.5.0-alpha.0",
  "description": "Schema-first, headless, block-based rich text editor for React.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./export-html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js",
      "require": "./dist/html.cjs"
    },
    "./export-markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "require": "./dist/markdown.cjs"
    },
    "./export-docx": {
      "types": "./dist/docx.d.ts",
      "import": "./dist/docx.js",
      "require": "./dist/docx.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsup",
    "demo": "vite --config demo/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "smoke:exports": "node scripts/smoke-exports.mjs",
    "validate:release": "pnpm lint && pnpm test && pnpm typecheck && pnpm build && pnpm pack --dry-run && pnpm smoke:exports"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^3.2.0"
  }
}
