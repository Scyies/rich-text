{
  "name": "mogul-text-editor",
  "version": "0.7.0",
  "description": "Schema-first, headless, block-based rich text editor for React.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scyies/rich-text.git"
  },
  "homepage": "https://github.com/Scyies/rich-text#readme",
  "bugs": {
    "url": "https://github.com/Scyies/rich-text/issues"
  },
  "keywords": [
    "rich-text",
    "editor",
    "react",
    "block-editor",
    "notion"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./export-html": {
      "import": {
        "types": "./dist/html.d.ts",
        "default": "./dist/html.js"
      },
      "require": {
        "types": "./dist/html.d.cts",
        "default": "./dist/html.cjs"
      }
    },
    "./export-markdown": {
      "import": {
        "types": "./dist/markdown.d.ts",
        "default": "./dist/markdown.js"
      },
      "require": {
        "types": "./dist/markdown.d.cts",
        "default": "./dist/markdown.cjs"
      }
    },
    "./export-docx": {
      "import": {
        "types": "./dist/docx.d.ts",
        "default": "./dist/docx.js"
      },
      "require": {
        "types": "./dist/docx.d.cts",
        "default": "./dist/docx.cjs"
      }
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "build:demo": "vite build --config demo/vite.config.ts",
    "demo": "vite --config demo/vite.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:demo": "tsc --noEmit -p demo/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "smoke:exports": "node scripts/smoke-exports.mjs",
    "smoke:consumer": "node scripts/smoke-consumer.mjs",
    "check:release-tag": "node scripts/check-release-tag.mjs",
    "validate:release": "pnpm lint && pnpm test:coverage && pnpm typecheck && pnpm typecheck:demo && pnpm build && pnpm build:demo && pnpm pack --dry-run && pnpm smoke:exports && pnpm smoke:consumer && pnpm check:release-tag"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "docx": "^9.7.1",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "docx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "3.2.6",
    "docx": "^9.7.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^3.2.0"
  }
}
